{
  "name": "hot-trend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HOT TREND V1.0 — 抖音 / 快手 热点聚合看板（纯静态、无 API、无后端）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "update:data": "node scripts/update.mjs",
    "update:data:dry": "node scripts/update.mjs --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
